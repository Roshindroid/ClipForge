# APP_URL: The URL where this applet is hosted.
APP_URL=

# OLLAMA_HOST: Local Ollama server URL (llama3.2:3b / qwen2.5:3b fit cleanly in 4 GB VRAM).
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Multi-Provider Quota-Aware LLM Router (optional cloud overflow & faster scoring)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Custom OpenAI-Compatible Inference Endpoint (e.g., Colab/T4, Cloudflare Worker, vLLM, LM Studio)
CUSTOM_LLM_URL=
CUSTOM_LLM_KEY=
CUSTOM_LLM_MODEL=

# yt-dlp JavaScript runtime (node or deno) for YouTube signature extraction
YTDLP_JS_RUNTIME=node

# yt-dlp browser cookies for YouTube bot verification (chrome, edge, firefox, brave, opera, etc.)
# Set this to the browser you're logged into YouTube with. Requires the browser to be closed.
YTDLP_COOKIES_FROM_BROWSER=chrome

# Alternative: path to a cookies.txt file exported from your browser (more reliable, no browser lock)
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
